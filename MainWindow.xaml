<Window x:Class="Oucx.Reader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Oucx Reader" Width="1240" Height="780" MinWidth="880" MinHeight="580"
        Icon="Assets/oucx-reader.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False" KeyDown="Window_KeyDown" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleRow" Height="46"/>
                <RowDefinition x:Name="ToolbarRow" Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="StatusRow" Height="28"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0" Background="#141719" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <Image Source="Assets/oucx-reader-icon.png" Width="27" Height="27"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="O U C X  R E A D E R" Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="DocumentTitle" Grid.Column="1" Text="No document open"
                               Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" FontFamily="Segoe Fluent Icons"
                                Width="46" Height="45" ToolTip="Minimize" Click="Minimize_Click"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource IconButton}" Content="&#xE922;"
                                FontFamily="Segoe Fluent Icons" Width="46" Height="45" ToolTip="Maximize"
                                Click="Maximize_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons"
                                Width="46" Height="45" ToolTip="Close" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Reader toolbar -->
            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentButton}" Click="Open_Click" ToolTip="Open PDF (Ctrl+O)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                                <TextBlock Text="Open PDF" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RecentToggle" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                Content="&#xE70D;" FontFamily="Segoe Fluent Icons" ToolTip="Toggle recent files"
                                Click="RecentToggle_Click"/>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Height="25" Background="{StaticResource BorderBrush}" Margin="10,0"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="PreviousPageButton" Style="{StaticResource IconButton}" Content="&#xE70E;"
                                FontFamily="Segoe Fluent Icons" ToolTip="Previous page (Page Up)" Click="PreviousPage_Click"/>
                        <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Margin="3,0" Padding="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="PageNumberBox" Text="1" Width="40" Background="Transparent"
                                         Foreground="{StaticResource PrimaryTextBrush}" BorderThickness="0"
                                         TextAlignment="Center" VerticalContentAlignment="Center" Padding="2,5"
                                         PreviewKeyDown="PageNumberBox_PreviewKeyDown"/>
                                <TextBlock Text="page" Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,9,0" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="NextPageButton" Style="{StaticResource IconButton}" Content="&#xE70D;"
                                FontFamily="Segoe Fluent Icons" ToolTip="Next page (Page Down)" Click="NextPage_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE71A;" FontFamily="Segoe Fluent Icons"
                                ToolTip="Find in document (Ctrl+F)" Click="Find_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" FontFamily="Segoe Fluent Icons"
                                ToolTip="Zoom out (Ctrl+-)" Click="ZoomOut_Click"/>
                        <TextBlock x:Name="ZoomText" Text="100%" Width="48" TextAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A4;" FontFamily="Segoe Fluent Icons"
                                ToolTip="Zoom in (Ctrl++)" Click="ZoomIn_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE749;" FontFamily="Segoe Fluent Icons"
                                ToolTip="Print (Ctrl+P)" Click="Print_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE740;" FontFamily="Segoe Fluent Icons"
                                ToolTip="Full screen (F11)" Click="FullScreen_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Background="#25292D">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="Sidebar" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="R E C E N T   D O C U M E N T S" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="4,5,0,14"/>
                        <ListBox x:Name="RecentFilesList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 ItemsSource="{Binding RecentFiles}" SelectionChanged="RecentFilesList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,5"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Card" Background="{TemplateBinding Background}" CornerRadius="7"
                                                        Padding="9,9" Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="{StaticResource RaisedBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xEA90;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Folder}" FontSize="10" Margin="0,3,0,0"
                                                       Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="2" Text="Tip: Drop a PDF anywhere to open it" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="4,12,4,2"/>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <wv2:WebView2 x:Name="PdfWebView" DefaultBackgroundColor="#25292D"
                                  NavigationStarting="PdfWebView_NavigationStarting"
                                  NavigationCompleted="PdfWebView_NavigationCompleted"/>

                    <Grid x:Name="WelcomePanel" Background="#25292D">
                        <StackPanel Width="430" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="88" Height="88" Background="#2E3338" CornerRadius="22" HorizontalAlignment="Center">
                                <TextBlock Text="&#xEA90;" FontFamily="Segoe Fluent Icons" FontSize="38"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Your documents, in focus" FontSize="26" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,24,0,8"/>
                            <TextBlock Text="Open a PDF to read, search, print, or present.&#x0a;You can also drag a file directly into this window."
                                       TextAlignment="Center" LineHeight="22" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <Button Style="{StaticResource AccentButton}" Content="Choose a PDF" HorizontalAlignment="Center"
                                    Margin="0,24,0,0" Click="Open_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="LoadingPanel" Background="#CC25292D" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="180" Height="3" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Opening document…" Margin="0,14,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="3" Background="#141719" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="WebView2 PDF engine" FontSize="10" Foreground="#626A72"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
